{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "task -x hook:context",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "command -v vibe-guard >/dev/null 2>&1 || { echo \"vibe-guard is not installed; install it: go install github.com/Manual-debuger/VibeConform/cmd/vibe-guard@v0.11.0-alpha.1.0.20261018050009-72787646f76c\" >&2; exit 2; }; vibe-guard hook"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "task -x hook:format",
            "timeout": 60
          },
          {
            "type": "command",
            "command": "task -x hook:check",
            "timeout": 300,
            "asyncRewake": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "vibe-guard relock 2>/dev/null; task verify:fast 1>&2 </dev/null || task -x hook:done",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
