{
  "version": 1,
  "tools": {
    "command": ["Bash", "PowerShell"],
    "file_path": ["Edit", "MultiEdit", "Write"]
  },
  "rules": [
    {
      "id": "rm-rf",
      "field": "command",
      "pattern": "(^|[^a-zA-Z0-9_.-])rm[ \\t]+([^ \\t;&|\\n]+[ \\t]+){0,16}(-[a-zA-Z]*[rR][a-zA-Z]*|--r(e(c(u(r(s(i(v(e)?)?)?)?)?)?)?)?)(:[^ \\t;&|\\n]*)?[ \\t]+([^ \\t;&|\\n]+[ \\t]+){0,16}(-[a-zA-Z]*f[a-zA-Z]*|--f(o(r(c(e)?)?)?)?)([^a-zA-Z0-9_-]|$)|(^|[^a-zA-Z0-9_.-])rm[ \\t]+([^ \\t;&|\\n]+[ \\t]+){0,16}(-[a-zA-Z]*f[a-zA-Z]*|--f(o(r(c(e)?)?)?)?)(:[^ \\t;&|\\n]*)?[ \\t]+([^ \\t;&|\\n]+[ \\t]+){0,16}(-[a-zA-Z]*[rR][a-zA-Z]*|--r(e(c(u(r(s(i(v(e)?)?)?)?)?)?)?)?)([^a-zA-Z0-9_-]|$)|(^|[^a-zA-Z0-9_.-])rm[ \\t]+([^ \\t;&|\\n]+[ \\t]+){0,16}-[a-zA-Z]*([rR][a-zA-Z]*f|f[a-zA-Z]*[rR])",
      "raw": "(^|[^a-zA-Z0-9_.-])rm[ \\t]+([^ \\t;&|\\n]+[ \\t]+){0,16}(-[a-zA-Z]*[rR][a-zA-Z]*|--r(e(c(u(r(s(i(v(e)?)?)?)?)?)?)?)?)(:[^ \\t;&|\\n]*)?[ \\t]+([^ \\t;&|\\n]+[ \\t]+){0,16}(-[a-zA-Z]*f[a-zA-Z]*|--f(o(r(c(e)?)?)?)?)([^a-zA-Z0-9_-]|$)|(^|[^a-zA-Z0-9_.-])rm[ \\t]+([^ \\t;&|\\n]+[ \\t]+){0,16}(-[a-zA-Z]*f[a-zA-Z]*|--f(o(r(c(e)?)?)?)?)(:[^ \\t;&|\\n]*)?[ \\t]+([^ \\t;&|\\n]+[ \\t]+){0,16}(-[a-zA-Z]*[rR][a-zA-Z]*|--r(e(c(u(r(s(i(v(e)?)?)?)?)?)?)?)?)([^a-zA-Z0-9_-]|$)|(^|[^a-zA-Z0-9_.-])rm[ \\t]+([^ \\t;&|\\n]+[ \\t]+){0,16}-[a-zA-Z]*([rR][a-zA-Z]*f|f[a-zA-Z]*[rR])",
      "message": "Blocked: rm -rf (or equivalent) is a destructive operation. Ask the user to run it themselves (in Claude Code: ! <command>)."
    },
    {
      "id": "remove-item-recurse-force",
      "field": "command",
      "pattern": "(^|[^a-zA-Z0-9_.-])([Rr][Ee][Mm][Oo][Vv][Ee]-[Ii][Tt][Ee][Mm]|[Rr][Ii]|[Dd][Ee][Ll]|[Ee][Rr][Aa][Ss][Ee]|[Rr][Dd]|[Rr][Mm][Dd][Ii][Rr]|[Rr][Mm])[ \\t]+([^ \\t;&|\\n]+[ \\t]+){0,16}-[Rr]([Ee]([Cc]([Uu]([Rr]([Ss]([Ee])?)?)?)?)?)?(:[^ \\t;&|\\n]*)?[ \\t]+([^ \\t;&|\\n]+[ \\t]+){0,16}-[Ff][Oo]([Rr]([Cc]([Ee])?)?)?([^a-zA-Z0-9_-]|$)|(^|[^a-zA-Z0-9_.-])([Rr][Ee][Mm][Oo][Vv][Ee]-[Ii][Tt][Ee][Mm]|[Rr][Ii]|[Dd][Ee][Ll]|[Ee][Rr][Aa][Ss][Ee]|[Rr][Dd]|[Rr][Mm][Dd][Ii][Rr]|[Rr][Mm])[ \\t]+([^ \\t;&|\\n]+[ \\t]+){0,16}-[Ff][Oo]([Rr]([Cc]([Ee])?)?)?(:[^ \\t;&|\\n]*)?[ \\t]+([^ \\t;&|\\n]+[ \\t]+){0,16}-[Rr]([Ee]([Cc]([Uu]([Rr]([Ss]([Ee])?)?)?)?)?)?([^a-zA-Z0-9_-]|$)",
      "raw": "(^|[^a-zA-Z0-9_.-])([Rr][Ee][Mm][Oo][Vv][Ee]-[Ii][Tt][Ee][Mm]|[Rr][Ii]|[Dd][Ee][Ll]|[Ee][Rr][Aa][Ss][Ee]|[Rr][Dd]|[Rr][Mm][Dd][Ii][Rr]|[Rr][Mm])[ \\t]+([^ \\t;&|\\n]+[ \\t]+){0,16}-[Rr]([Ee]([Cc]([Uu]([Rr]([Ss]([Ee])?)?)?)?)?)?(:[^ \\t;&|\\n]*)?[ \\t]+([^ \\t;&|\\n]+[ \\t]+){0,16}-[Ff][Oo]([Rr]([Cc]([Ee])?)?)?([^a-zA-Z0-9_-]|$)|(^|[^a-zA-Z0-9_.-])([Rr][Ee][Mm][Oo][Vv][Ee]-[Ii][Tt][Ee][Mm]|[Rr][Ii]|[Dd][Ee][Ll]|[Ee][Rr][Aa][Ss][Ee]|[Rr][Dd]|[Rr][Mm][Dd][Ii][Rr]|[Rr][Mm])[ \\t]+([^ \\t;&|\\n]+[ \\t]+){0,16}-[Ff][Oo]([Rr]([Cc]([Ee])?)?)?(:[^ \\t;&|\\n]*)?[ \\t]+([^ \\t;&|\\n]+[ \\t]+){0,16}-[Rr]([Ee]([Cc]([Uu]([Rr]([Ss]([Ee])?)?)?)?)?)?([^a-zA-Z0-9_-]|$)",
      "message": "Blocked: Remove-Item -Recurse -Force (or equivalent) is a destructive operation. Ask the user to run it themselves (in Claude Code: ! <command>)."
    },
    {
      "id": "git-reset-hard",
      "field": "command",
