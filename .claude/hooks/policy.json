      "raw": "(^|[^a-zA-Z0-9_.-])git([ \\t]+(-[Cc][ \\t]+[^ \\t;&|\\n]+|--(git-dir|work-tree|namespace|exec-path|super-prefix|config-env)[ \\t]+[^ \\t;&|\\n]+|-[^ \\t;&|\\n]*)){0,8}[ \\t]+clean[ \\t]+([^ \\t;&|\\n]+[ \\t]+){0,16}(-[a-zA-Z]*f[a-zA-Z]*|--f(o(r(c(e)?)?)?)?)(:[^ \\t;&|\\n]*)?[ \\t]+([^ \\t;&|\\n]+[ \\t]+){0,16}-[a-zA-Z]*d[a-zA-Z]*([^a-zA-Z0-9_-]|$)|(^|[^a-zA-Z0-9_.-])git([ \\t]+(-[Cc][ \\t]+[^ \\t;&|\\n]+|--(git-dir|work-tree|namespace|exec-path|super-prefix|config-env)[ \\t]+[^ \\t;&|\\n]+|-[^ \\t;&|\\n]*)){0,8}[ \\t]+clean[ \\t]+([^ \\t;&|\\n]+[ \\t]+){0,16}-[a-zA-Z]*d[a-zA-Z]*(:[^ \\t;&|\\n]*)?[ \\t]+([^ \\t;&|\\n]+[ \\t]+){0,16}(-[a-zA-Z]*f[a-zA-Z]*|--f(o(r(c(e)?)?)?)?)([^a-zA-Z0-9_-]|$)|(^|[^a-zA-Z0-9_.-])git([ \\t]+(-[Cc][ \\t]+[^ \\t;&|\\n]+|--(git-dir|work-tree|namespace|exec-path|super-prefix|config-env)[ \\t]+[^ \\t;&|\\n]+|-[^ \\t;&|\\n]*)){0,8}[ \\t]+clean[ \\t]+([^ \\t;&|\\n]+[ \\t]+){0,16}-[a-zA-Z]*(f[a-zA-Z]*d|d[a-zA-Z]*f)",
      "message": "Blocked: git clean -fd (or equivalent) permanently deletes untracked files. Ask the user to run it themselves (in Claude Code: ! <command>)."
    },
    {
      "id": "git-push-force",
      "field": "command",
      "pattern": "(^|[^a-zA-Z0-9_.-])git([ \\t]+(-[Cc][ \\t]+[^ \\t;&|\\n]+|--(git-dir|work-tree|namespace|exec-path|super-prefix|config-env)[ \\t]+[^ \\t;&|\\n]+|-[^ \\t;&|\\n]*)){0,8}[ \\t]+push[ \\t]+([^ \\t;&|\\n]+[ \\t]+){0,16}(-[a-zA-Z]*f[a-zA-Z]*([^a-zA-Z0-9_-]|$)|--force([^a-zA-Z0-9_-]|$)|[\"']?\\+[^ \\t])",
      "raw": "(^|[^a-zA-Z0-9_.-])git([ \\t]+(-[Cc][ \\t]+[^ \\t;&|\\n]+|--(git-dir|work-tree|namespace|exec-path|super-prefix|config-env)[ \\t]+[^ \\t;&|\\n]+|-[^ \\t;&|\\n]*)){0,8}[ \\t]+push[ \\t]+([^ \\t;&|\\n]+[ \\t]+){0,16}(-[a-zA-Z]*f[a-zA-Z]*([^a-zA-Z0-9_-]|$)|--force([^a-zA-Z0-9_-]|$)|[\"']?\\+[^ \\t])",
      "message": "Blocked: git push --force (or a +refspec) can overwrite remote history. Ask the user to run it themselves (in Claude Code: ! <command>)."
    },
    {
