      "raw": "(^|[^a-zA-Z0-9_.-])git([ \\t]+(-[Cc][ \\t]+[^ \\t;&|\\n]+|--(git-dir|work-tree|namespace|exec-path|super-prefix|config-env)[ \\t]+[^ \\t;&|\\n]+|-[^ \\t;&|\\n]*)){0,8}[ \\t]+restore[ \\t]+(([^- \\t;&|\\n][^ \\t;&|\\n]*|--|--[^s \\t;&|\\n][^ \\t;&|\\n]*|--s[^t \\t;&|\\n][^ \\t;&|\\n]*|-[a-zA-RT-Z0-9]+)[ \\t]+){0,16}[\"']?(\\.|\\./|:/)[\"']?([ \\t;&|)]|$)|(^|[^a-zA-Z0-9_.-])git([ \\t]+(-[Cc][ \\t]+[^ \\t;&|\\n]+|--(git-dir|work-tree|namespace|exec-path|super-prefix|config-env)[ \\t]+[^ \\t;&|\\n]+|-[^ \\t;&|\\n]*)){0,8}[ \\t]+restore[ \\t]+([^ \\t;&|\\n]+[ \\t]+){0,16}(-[a-zA-Z]*W[a-zA-Z]*|--w(o(r(k(t(r(e(e)?)?)?)?)?)?)?)(:[^ \\t;&|\\n]*)?[ \\t]+([^ \\t;&|\\n]+[ \\t]+){0,16}[\"']?(\\.|\\./|:/)[\"']?([^a-zA-Z0-9_-]|$)|(^|[^a-zA-Z0-9_.-])git([ \\t]+(-[Cc][ \\t]+[^ \\t;&|\\n]+|--(git-dir|work-tree|namespace|exec-path|super-prefix|config-env)[ \\t]+[^ \\t;&|\\n]+|-[^ \\t;&|\\n]*)){0,8}[ \\t]+restore[ \\t]+([^ \\t;&|\\n]+[ \\t]+){0,16}[\"']?(\\.|\\./|:/)[\"']?(:[^ \\t;&|\\n]*)?[ \\t]+([^ \\t;&|\\n]+[ \\t]+){0,16}(-[a-zA-Z]*W[a-zA-Z]*|--w(o(r(k(t(r(e(e)?)?)?)?)?)?)?)([^a-zA-Z0-9_-]|$)|(^|[^a-zA-Z0-9_.-])git([ \\t]+(-[Cc][ \\t]+[^ \\t;&|\\n]+|--(git-dir|work-tree|namespace|exec-path|super-prefix|config-env)[ \\t]+[^ \\t;&|\\n]+|-[^ \\t;&|\\n]*)){0,8}[ \\t]+checkout[ \\t]+([^ \\t;&|\\n]+[ \\t]+){0,16}[\"']?(\\.|\\./|:/)[\"']?([ \\t;&|)]|$)",
      "message": "Blocked: git restore . (or git checkout -- .) discards uncommitted changes to tracked files. Ask the user to run it themselves (in Claude Code: ! <command>)."
