      "raw": "(^|[^a-zA-Z0-9_.-])git([ \\t]+(-[Cc][ \\t]+[^ \\t;&|\\n]+|--(git-dir|work-tree|namespace|exec-path|super-prefix|config-env)[ \\t]+[^ \\t;&|\\n]+|-[^ \\t;&|\\n]*)){0,8}[ \\t]+reset[ \\t]+([^ \\t;&|\\n]+[ \\t]+){0,16}--ha(r(d)?)?([^a-zA-Z0-9_-]|$)",
      "message": "Blocked: git reset --hard discards uncommitted work. Ask the user to run it themselves (in Claude Code: ! <command>)."
    },
    {
