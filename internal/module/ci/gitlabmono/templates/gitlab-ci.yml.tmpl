# GitLab CI for this repository, generated by VibeConform (prod-mono/v1).
#
# Every job below runs a Taskfile target so CI, local dev, and docs never
# duplicate independent command lists. See Taskfile.yml.
#
# One job per component, named by the component's id: each uses only its
# own toolchain image, installs its dependencies in its own directory, and
# runs its own verify. Every job declares the keys that decide whether and
# how it runs, so an included file cannot change them by merging into it.
#
# Project-owned jobs go in .gitlab-ci.local.yml, which the local job below
# runs as a child pipeline when the file exists. A child pipeline can add
# jobs but cannot redefine these ones, and its result is this pipeline's.
#
# Where and how fast these jobs run is the project's: runner tags, retry,
# services and the like go under default: in .gitlab-ci.defaults.yml, and
# the cache policy comes from VIBE_CACHE_POLICY. What they run, and whether
# their result counts, stays here. The conformance audit fails a defaults
# file with any top-level key but default:.
# See docs/specs/0038-ci-provider.md, docs/specs/0040-ci-floor-environment-seam.md
# and docs/usage.md's "CI provider".

workflow:
  rules:
    # Merge request pipelines, and branch pipelines for branches without
    # an open merge request: one pipeline per change, never two.
    #
    # Opt-in (project CI/CD variable VIBE_MR_CACHE_POLICY=pull): merge
    # request pipelines read caches without uploading them again. Off by
    # default: under GitLab's separate caches for protected branches, a
    # Developer's merge request pipeline would then never get a cache.
    - if: $CI_PIPELINE_SOURCE == "merge_request_event" && $VIBE_MR_CACHE_POLICY == "pull"
      variables:
        VIBE_CACHE_POLICY: pull
    - if: $CI_PIPELINE_SOURCE == "merge_request_event"
    - if: $CI_COMMIT_BRANCH && $CI_OPEN_MERGE_REQUESTS
      when: never
    - if: $CI_COMMIT_BRANCH

include:
  # VibeConform's conformance job, kept in a file of its own so that
  # removing VibeConform deletes files rather than editing this one. With
  # the file gone, this include does nothing.
  - local: .gitlab-ci.vibe.yml
    rules:
      - exists:
          - .gitlab-ci.vibe.yml
  # The project's defaults for every job here: default: only.
  - local: .gitlab-ci.defaults.yml
    rules:
      - exists:
          - .gitlab-ci.defaults.yml

variables:
  # Each component job's cache policy. A project CI/CD variable overrides it.
  VIBE_CACHE_POLICY: "pull-push"
[[- if .HasGo]]
  GO_VERSION: "[[$.Pins.Go]]"
[[- end]]
  TASK_VERSION: "[[$.Pins.Task]]"
[[- if .NeedsTaskArchive]]
  # The task_linux_amd64.tar.gz checksum of TASK_VERSION's release. Change
  # both together.
  TASK_SHA256: "[[$.Pins.TaskSHA256]]"
[[- end]]
[[- if .HasGo]]
  GOLANGCI_LINT_VERSION: "[[$.Pins.GolangciLint]]"
[[- end]]
[[- if .HasTS]]
  NODE_VERSION: "[[$.Pins.Node]]"
[[- end]]
[[- if .HasPy]]
  PYTHON_VERSION: "[[$.Pins.Python]]"
[[- end]]
[[- range .Components]]
[[- if eq .Profile "go"]]

[[.ID]]:
  stage: test
  image: golang:${GO_VERSION}
  needs: []
  rules:
    - when: on_success
  allow_failure: false
  interruptible: true
  variables:
    GOMODCACHE: $CI_PROJECT_DIR/.ci-cache/[[.ID]]/mod
    GOCACHE: $CI_PROJECT_DIR/.ci-cache/[[.ID]]/build
    # GOCACHE also holds test results: run the tests rather than replay a
    # cached pass. Commands other than go test ignore the flag.
    GOFLAGS: "-count=1"
  cache:
    key:
      prefix: [[.ID]]
      files:
        - [[.Path]]/go.mod
    paths:
      - .ci-cache/[[.ID]]/
    policy: $VIBE_CACHE_POLICY
  before_script: []
  script:
    - go install github.com/go-task/task/v3/cmd/task@${TASK_VERSION}
    - go install golang.org/x/tools/cmd/goimports@[[$.Pins.Goimports]]
    - go install github.com/golangci/golangci-lint/v2/cmd/golangci-lint@${GOLANGCI_LINT_VERSION}
    - go install golang.org/x/vuln/cmd/govulncheck@[[$.Pins.Govulncheck]]
    - task [[.ID]]:verify
    - task [[.ID]]:test:race
[[- else if eq .Profile "ts"]]

[[.ID]]:
  stage: test
  image: node:${NODE_VERSION}
  needs: []
  rules:
    - when: on_success
  allow_failure: false
  interruptible: true
  variables:
    COREPACK_ENABLE_DOWNLOAD_PROMPT: "0"
  cache:
    key:
      prefix: [[.ID]]
      files:
        - [[.Path]]/pnpm-lock.yaml
    paths:
      - .ci-cache/[[.ID]]/
    policy: $VIBE_CACHE_POLICY
  before_script: []
  script:
    - curl -fsSL -o /tmp/task.tar.gz "https://github.com/go-task/task/releases/download/${TASK_VERSION}/task_linux_amd64.tar.gz"
    - echo "${TASK_SHA256}  /tmp/task.tar.gz" | sha256sum -c -
    - tar -xzf /tmp/task.tar.gz -C /usr/local/bin task
    # pnpm's version comes from the component's package.json
    # packageManager field (docs/specs/0020-prod-ts-pnpm.md).
    - corepack enable
    - (cd [[.Path]] && pnpm config set store-dir "$CI_PROJECT_DIR/.ci-cache/[[.ID]]/pnpm-store" && pnpm install --frozen-lockfile)
    - task [[.ID]]:verify
[[- else if eq .Profile "py"]]

[[.ID]]:
  stage: test
  # Not -slim: pyright's bundled Node needs libatomic, which the slim
  # image lacks.
  image: ghcr.io/astral-sh/uv:python${PYTHON_VERSION}-bookworm
  needs: []
  rules:
    - when: on_success
  allow_failure: false
  interruptible: true
  variables:
    UV_CACHE_DIR: $CI_PROJECT_DIR/.ci-cache/[[.ID]]/uv
  cache:
    key:
      prefix: [[.ID]]
      files:
        - [[.Path]]/uv.lock
    paths:
      - .ci-cache/[[.ID]]/
    policy: $VIBE_CACHE_POLICY
  before_script: []
  script:
    - curl -fsSL -o /tmp/task.tar.gz "https://github.com/go-task/task/releases/download/${TASK_VERSION}/task_linux_amd64.tar.gz"
    - echo "${TASK_SHA256}  /tmp/task.tar.gz" | sha256sum -c -
    - tar -xzf /tmp/task.tar.gz -C /usr/local/bin task
    - (cd [[.Path]] && uv sync)
    - task [[.ID]]:verify
[[- end]]
[[- end]]

# The project's own jobs, from .gitlab-ci.local.yml, as a child pipeline.
# mirror makes this job's status the child pipeline's, so a failing
# project job fails this pipeline. Without the file, this job is skipped.
local:
  stage: test
  needs: []
  rules:
    - exists:
        - .gitlab-ci.local.yml
  allow_failure: false
  interruptible: true
  # The child pipeline sets its own defaults in .gitlab-ci.local.yml.
  inherit:
    default: false
  trigger:
    include:
      - local: .gitlab-ci.local.yml
    strategy: mirror
