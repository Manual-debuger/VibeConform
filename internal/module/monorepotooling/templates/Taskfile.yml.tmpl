version: "3"

# The root of a prod-mono/v1 repository. Each component has its own
# generated Taskfile.yml, included below under the component's id: run one
# component's task as "task <id>:<task>" (task api:test), or run "task
# <task>" here to run it for every component in vibe.yaml order. See
# docs/specs/0025-prod-mono.md.
#
# Repository-specific tasks — build, run, deploy, whatever this repository
# happens to need — belong in a project-owned Taskfile.local.yml, which
# VibeConform never writes, reads, or audits. The include is optional: with
# no such file it does nothing. Tasks defined there are available
# unprefixed, but cannot redefine a task below — Task exits 203 on a name
# collision rather than silently overriding, so the verification interface
# stays what the standard says it is. Requires Task v3.39.0 or newer.
# See docs/decisions/0009-managed-file-local-extension.md.
includes:
  local:
    taskfile: ./Taskfile.local.yml
    optional: true
    flatten: true
  # VibeConform's own tasks (task audit), kept out of this file so that
  # removing VibeConform is deleting Taskfile.vibe.yml, not editing this
  # one. Optional for the same reason: with the file gone, this include
  # does nothing. See docs/specs/0022-conformance-isolation.md.
  vibe:
    taskfile: ./Taskfile.vibe.yml
    optional: true
    flatten: true
[[- range .Components]]
  [[.ID]]:
    taskfile: ./[[.Path]]/Taskfile.yml
    dir: ./[[.Path]]
[[- end]]

# Task's built-in shell (mvdan.cc/sh) interprets POSIX-style syntax
# identically on Windows/Linux/macOS, so these commands need no per-OS
# branching.

tasks:
[[- range $i, $t := .FanOut]]
[[- if $i]]
[[end]]
  [[$t.Name]]:
    desc: [[$t.Desc]]
    cmds:
[[- range $.Components]]
      - task: [[.ID]]:[[$t.Name]]
[[- end]]
[[- end]]
[[- if .GitHub]]

  workflows:lint:
    desc: Validate GitHub Actions workflow files.
    cmds:
      - actionlint
[[- end]]

  # Called by Claude Code, not by people: .claude/settings.json runs
  # "task -x hook:guard" before every shell command and file edit. No desc,
  # so it stays out of task --list. The -x in that command matters: without
  # it Task reports the guard's deny (exit 2) as 201, which the agent
  # treats as allow. The guard runs in the first runtime this repository
  # has, in the order Go, Node, Python. See
  # docs/specs/0021-agent-hooks-task-interface.md.
  #
  # "|| exit 2" turns any failure inside the task into a deny rather than
  # an allow: a missing or broken runtime would otherwise let every tool
  # call through.
  hook:guard:
    silent: true
    cmds:
      - [[.GuardCommand]] || exit 2

  # The other agent hooks (spec 0023). Like hook:guard, agents call these
  # through "task -x hook:<name>", and none has a desc. Exit 2 is the one
  # code agents show the model; the scripts use only Task's built-in shell
  # and git, so they behave the same on Windows and Linux.
  # Task runs each cmd with errexit, so every command that can fail on a
  # healthy machine (a missing runtime, no commit yet) ends in "|| true"
  # or "|| echo missing"; unguarded, it would end the script early.
  #
  # Session start: a few lines of facts for the agent's context. Never
  # installs, builds, tests, or starts anything; those stay explicit tasks.
  # Platform comes from Task itself, and Runtime only from marker files, so
  # neither is a guess. The shell is not reported: the harness doesn't say
  # which one the agent's command tool uses, and the OS doesn't settle it
  # (docs/specs/0028-environment-doctor.md).
  hook:context:
    silent: true
    cmds:
      - |
        if git rev-parse --git-dir >/dev/null 2>&1; then
          echo "Repo: {{base .ROOT_DIR}}"
        else
          echo "Repo: {{base .ROOT_DIR}} (not a git repository)"
        fi
        echo "Platform: {{OS}}/{{ARCH}}"
        runtime=native
        if test -e /proc/sys/fs/binfmt_misc/WSLInterop; then
          runtime=wsl
        elif test -e /.dockerenv || test -e /run/.containerenv; then
          runtime=container
        fi
        echo "Runtime: $runtime"
        echo "Shell: unknown (not reported by the harness)"
        git rev-parse --git-dir >/dev/null 2>&1 || exit 0
        gitdir="$(git rev-parse --path-format=absolute --git-dir 2>/dev/null || true)"
        common="$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)"
        [ "$gitdir" = "$common" ] || echo "Worktree: linked (main checkout at ${common%/.git})"
        b="$(git branch --show-current 2>/dev/null || true)"
        [ -n "$b" ] || b="detached at $(git rev-parse --short HEAD 2>/dev/null || echo "an unborn branch")"
        echo "Branch: $b"
        status="$(git status --short 2>/dev/null || true)"
        state=clean
        [ -z "$status" ] || state=dirty
        for p in rebase-merge:rebase rebase-apply:rebase MERGE_HEAD:merge CHERRY_PICK_HEAD:cherry-pick REVERT_HEAD:revert BISECT_LOG:bisect; do
          if [ -e "$(git rev-parse --git-path "${p%%:*}")" ]; then state="$state, ${p#*:} in progress"; fi
        done
        echo "State: $state"
[[- if .HasGo]]
        echo "Go: $(go env GOVERSION 2>/dev/null || echo missing)"
[[- end]]
[[- if .HasTS]]
        echo "Node: $(node --version 2>/dev/null || echo missing)"
        echo "pnpm: $(pnpm --version 2>/dev/null || echo missing)"
[[- end]]
[[- if .HasPy]]
        echo "uv: $(uv --version 2>/dev/null || echo missing)"
        py="$(uv python find 2>/dev/null || true)"
        echo "Python: $([ -n "$py" ] && "$py" --version 2>/dev/null || echo missing)"
[[- end]]
        echo "Task: {{.TASK_VERSION}}"
        echo "Components (task <id>:<task>):"
[[- range .Components]]
        echo "  [[.ID]]: [[.Path]] ([[.Profile]])"
[[- end]]
        n=0
        while IFS= read -r line; do
          [ -n "$line" ] || continue
          n=$((n+1))
          [ "$n" -le 20 ] && list="$list$line
        "
        done <<EOF
        $status
        EOF
        echo "Dirty files: $n"
        printf '%s' "$list"
        [ "$n" -le 20 ] || echo "… and $((n-20)) more"
        dirstat="$(git diff --dirstat=files,0 HEAD 2>/dev/null || true)"
        if [ -n "$dirstat" ]; then
          echo "Affected directories:"
          echo "$dirstat"
        fi

  # After each file edit: every component formats its own changed files
  # (its fmt:changed task), not the whole repository. Each runs as its own
  # task process started inside the component, not as "task <id>:..."
  # through the include: Task's built-in xargs, which Windows uses, runs
  # its command in the process's directory and ignores the include's dir.
  # Every component is formatted even if an earlier one fails.
  hook:format:
    silent: true
    cmds:
      - |
        rc=0
[[- range .Components]]
        (cd [[.Path]] && task -s fmt:changed) || rc=2
[[- end]]
        exit $rc

  # After each file edit, in the background: the typecheck and the lint,
  # no tests and no fmt:check (spec 0057). An edit in the middle of a
  # change rarely passes the tests; the Stop gate's verify:fast runs them,
  # and checks formatting, at the end of the turn. Agents run all of an
  # event's hooks in parallel, so a format check here would race
  # hook:format. The tools' output goes to stderr, which is what the agent
  # is shown.
  # A payload with a non-empty agent_id comes from a sub-agent, and runs
  # nothing: asyncRewake would wake the parent session with the sub-agent's
  # failures, and a test-first red phase fails on purpose.
  # An edit outside the repository (the agent's memory, its scratchpad) or
  # of a file git ignores cannot change the checks' result, so it runs
  # nothing (spec 0056). The path comes from the payload's file_path or
  # notebook_path, JSON-escaped; git reads doubled backslashes as one.
  # git check-ignore exits 0 for an ignored path, 1 for any other path in
  # the repository and 128 outside it. Without a path (a malformed payload,
  # a tool with no path) or a repository, the checks run.
  hook:check:
    silent: true
    cmds:
      - |
        in="$(cat)"
        case "$in" in
          *'"agent_id":""'*|*'"agent_id": ""'*) ;;
          *'"agent_id":"'*|*'"agent_id": "'*) exit 0 ;;
        esac
        p=""
        case "$in" in
          *'"file_path":"'*) p="${in#*\"file_path\":\"}" ;;
          *'"file_path": "'*) p="${in#*\"file_path\": \"}" ;;
          *'"notebook_path":"'*) p="${in#*\"notebook_path\":\"}" ;;
          *'"notebook_path": "'*) p="${in#*\"notebook_path\": \"}" ;;
        esac
        case "$p" in
          *'"'*) p="${p%%\"*}" ;;
          *) p="" ;;
        esac
        if [ -n "$p" ] && git rev-parse --git-dir >/dev/null 2>&1; then
          rc=0
          git check-ignore -q -- "$p" 2>/dev/null || rc=$?
          [ "$rc" -eq 1 ] || exit 0
        fi
        task -s[[range .Components]] [[.ID]]:typecheck [[.ID]]:lint[[end]] 1>&2 || exit 2

  # The green stamp (spec 0057): the Stop hook skips verify:fast when the
  # tree is the one its last green run saw. hook:stamp:check exits 0 when
  # the tree's hash equals the stamp and 1 otherwise: outside a Git
  # repository, before the first commit, with no stamp, or when a git call
  # fails, so a doubt always runs the checks. hook:stamp:save records the
  # hash after a green verify:fast and always exits 0. The hash covers
  # HEAD, the binary diff against HEAD (staged or not), and the untracked
  # files git does not ignore, names and contents: a copy of the index
  # marks them intent-to-add, so the diff shows them and git stores no
  # object. The stamp sits in the worktree's own Git directory, so it never
  # shows in git status and each linked worktree has its own. Neither task
  # reads stdin, which the Stop hook keeps for hook:done.
  hook:stamp:check:
    silent: true
    cmds:
      - |
        stamp="$(git rev-parse --path-format=absolute --git-path green-stamp 2>/dev/null)" || exit 1
        [ -f "$stamp" ] || exit 1
        w="$stamp.$$"
        h=""
        cp "$(git rev-parse --path-format=absolute --git-path index)" "$w.index" 2>/dev/null || true
        if GIT_INDEX_FILE="$w.index" git add --intent-to-add -- :/ >/dev/null 2>&1 &&
          { git rev-parse --verify HEAD && GIT_INDEX_FILE="$w.index" git diff --binary --no-ext-diff --no-textconv --no-color HEAD; } >"$w" 2>/dev/null; then
          h="$(git hash-object --no-filters -- "$w" 2>/dev/null || true)"
        fi
        rm -f "$w" "$w.index"
        [ -n "$h" ] && [ "$h" = "$(cat "$stamp")" ]

  hook:stamp:save:
    silent: true
    cmds:
      - |
        stamp="$(git rev-parse --path-format=absolute --git-path green-stamp 2>/dev/null)" || exit 0
        w="$stamp.$$"
        h=""
        cp "$(git rev-parse --path-format=absolute --git-path index)" "$w.index" 2>/dev/null || true
        if GIT_INDEX_FILE="$w.index" git add --intent-to-add -- :/ >/dev/null 2>&1 &&
          { git rev-parse --verify HEAD && GIT_INDEX_FILE="$w.index" git diff --binary --no-ext-diff --no-textconv --no-color HEAD; } >"$w" 2>/dev/null; then
          h="$(git hash-object --no-filters -- "$w" 2>/dev/null || true)"
        fi
        rm -f "$w" "$w.index"
        [ -z "$h" ] || printf '%s\n' "$h" >"$stamp" || true

  # When the agent ends its turn: the same checks, as a gate. The settings'
  # Stop hook calls verify:fast itself, so the contract audit sees it
  # (rule A-05), and runs this only when verify:fast fails:
  # "task verify:fast 1>&2 </dev/null || task -x hook:done". The failure
  # blocks the stop once. If the agent stops again with the checks still
  # failing (stop_hook_active), the stop goes through, with the failure
  # printed, rather than looping forever on something it can't fix.
  hook:done:
    silent: true
    cmds:
      - |
        case "$(cat)" in
          *'"stop_hook_active":true'*|*'"stop_hook_active": true'*)
            echo "hook:done: verify:fast still fails; this stop was already blocked once, so it goes through." >&2
            exit 0
            ;;
        esac
        echo "hook:done: verify:fast fails; fix it before ending the turn." >&2
        exit 2

  verify:
[[- if .GitHub]]
    desc: Local verification gate for every component, then the workflow
      files — native language tooling only, never VibeConform itself;
      "task audit" is VibeConform's check, which CI runs in its own
      Conformance workflow.
[[- else]]
    desc: Local verification gate for every component — native language
      tooling only, never VibeConform itself; "task audit" is
      VibeConform's check, which CI runs as a job of its own.
[[- end]]
    cmds:
[[- range .Components]]
      - task: [[.ID]]:verify
[[- end]]
[[- if .GitHub]]
      - task: workflows:lint
[[- end]]

  # The agents' Stop hook and background check run this after edits (spec
  # 0023): every component's own verify:fast.
  verify:fast:
    desc: Every component's fast incremental verification; what the agents'
      Stop hook runs. "task verify" is still the full gate.
    cmds:
[[- range .Components]]
      - task: [[.ID]]:verify:fast
[[- end]]

  verify-ci:
    desc: Alias used by CI so the workflow and local docs never drift.
    cmds:
      - task: verify
