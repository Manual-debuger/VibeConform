# Lefthook: fast checks at commit time, stronger checks at push time.
# CI (.github/workflows/ci.yml) is the authoritative full verification gate;
# these hooks are a fast local first line of defense, not a substitute.
#
# Pre-commit checks run per component, from the component's directory
# (root:), and only when a staged file of its language is inside it, so a
# commit touching one component checks only that one. Each runs the
# component's own Taskfile.yml tasks. See docs/specs/0025-prod-mono.md.

pre-commit:
  parallel: true
  commands:
[[- range .Components]]
    [[.ID]]-fmt:
      root: "[[.Path]]/"
      glob: "[[.Glob]]"
      run: task fmt:check
      fail_text: "Run 'task [[.ID]]:fmt' to format [[.ID]]."
    [[.ID]]-lint:
      root: "[[.Path]]/"
      glob: "[[.Glob]]"
      run: task lint
[[- end]]

pre-push:
  parallel: false
  commands:
    verify-fast:
      run: task verify:fast
