    {"name": "local: an exception for an unknown rule id lifts nothing", "want": "deny", "local": {"version": 1, "exceptions": [{"rule": "no-such-rule", "pattern": "git clean -fdx build/"}]}, "payload": {"tool_name": "Bash", "tool_input": {"command": "git clean -fdx build/"}}},
